# ========================================================
# 1. BẢO MẬT MÁY CHỦ & CHỐNG DUYỆT THƯ MỤC
# ========================================================
Options -Indexes -MultiViews

# Chặn truy cập trực tiếp vào các file cơ sở dữ liệu và file tạm SQLite
<FilesMatch "\.(db|sqlite|sqlite3|wal|shm|sql)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Chặn truy cập vào các file cấu hình, mã nguồn backend, môi trường, repo
<FilesMatch "^(\.env|\.git|\.cpanel\.yml|package\.json|package-lock\.json|server\.js|db\.js|update-.*\.zip)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# ========================================================
# 2. HTTP SECURITY HEADERS (OWASP RECOMMENDATIONS)
# ========================================================
<IfModule mod_headers.c>
    # Chống Clickjacking trên trang CMS và Website
    Header set X-Frame-Options "SAMEORIGIN"
    # Chống MIME-Type Sniffing
    Header set X-Content-Type-Options "nosniff"
    # Giới hạn thông tin chuyển tiếp Referrer
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    # Bảo vệ XSS cho trình duyệt cũ
    Header set X-XSS-Protection "1; mode=block"
    # Hạn chế quyền truy cập camera, mic, định vị
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ========================================================
# 3. URL REWRITING & ROUTING
# ========================================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Chặn hoàn toàn truy cập trực tiếp bằng HTTP vào thư mục /data/
  RewriteRule ^data(/.*)?$ - [F,L,NC]

  # 1. Cổng Webhook tự động deploy GitHub
  RewriteRule ^api/webhook/deploy/?$ deploy.php [L,QSA]

  # 2. Điều hướng tất cả REST API (/api/...) vào api.php
  RewriteRule ^api/(.*)$ api.php?endpoint=$1 [L,QSA]

  # 3. Cho phép truy cập /admin mở admin.html
  RewriteRule ^admin/?$ admin.html [L]

  # 4. Redirect 301 các link cũ blog-detail.html?slug=... sang /blog/:slug chuẩn SEO
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /blog-detail\.html\?slug=([^&\ ]+) [NC]
  RewriteRule ^blog-detail\.html$ /blog/%1? [R=301,L]

  # 5. URL bài viết Blog chuẩn SEO (/blog/:slug hoặc /blog/:slug.html)
  RewriteRule ^blog/([a-zA-Z0-9_-]+)(\.html)?/?$ blog-detail.html?slug=$1 [L,QSA]

  # 6. URL danh mục kiến thức (/blog hoặc /blog/)
  RewriteRule ^blog/?$ blog.html [L]

  # 7. Redirect 301 chuẩn hóa URL trang chủ (Loại bỏ index.html)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
  RewriteRule ^index\.html$ / [R=301,L]
</IfModule>
