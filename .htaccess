# ========================================================
# 1. BẢO MẬT MÁY CHỦ & CHỐNG DUYỆT THƯ MỤC
# ========================================================
Options -Indexes -MultiViews

# Chặn truy cập trực tiếp vào các file cơ sở dữ liệu và file tạm SQLite
<FilesMatch "\.(db|sqlite|sqlite3|wal|shm|sql)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Chặn truy cập vào các file cấu hình, mã nguồn backend, môi trường, repo
<FilesMatch "^(\.env|\.git|\.cpanel\.yml|package\.json|package-lock\.json|server\.js|db\.js|update-.*\.zip)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# ========================================================
# 2. HTTP SECURITY HEADERS (OWASP RECOMMENDATIONS)
# ========================================================
<IfModule mod_headers.c>
    # Chống Clickjacking trên trang CMS và Website
    Header set X-Frame-Options "SAMEORIGIN"
    # Chống MIME-Type Sniffing
    Header set X-Content-Type-Options "nosniff"
    # Giới hạn thông tin chuyển tiếp Referrer
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    # Bảo vệ XSS cho trình duyệt cũ
    Header set X-XSS-Protection "1; mode=block"
    # Hạn chế quyền truy cập camera, mic, định vị
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ========================================================
# 3. NÉN DỮ LIỆU TỐC ĐỘ CAO (GZIP / DEFLATE COMPRESSION)
# Giảm 70-80% dung lượng tải trang cho HTML, CSS, JS, SVG
# ========================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf font/woff font/woff2
</IfModule>

# ========================================================
# 4. BỘ NHỚ ĐỆM TRÌNH DUYỆT (BROWSER CACHE & EXPIRES)
# Tối ưu tải trang 0ms cho lượt truy cập tiếp theo
# ========================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # Ảnh & Icons tĩnh: 1 năm (immutable)
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Font chữ: 1 năm
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"

    # Stylesheet CSS & Scripts: 1 tháng
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"

    # HTML: Không cache lâu để luôn nhận nội dung mới nhất
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # Cấu hình Cache-Control tối ưu hiệu năng
    <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg|woff2?|ttf|otf)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>

    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>

    # API động luôn fresh (không cache dữ liệu động)
    <FilesMatch "api\.php$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    </FilesMatch>
</IfModule>

# ========================================================
# 5. URL REWRITING & ROUTING
# ========================================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Chặn hoàn toàn truy cập trực tiếp bằng HTTP vào thư mục /data/
  RewriteRule ^data(/.*)?$ - [F,L,NC]

  # 1. Cổng Webhook tự động deploy GitHub
  RewriteRule ^api/webhook/deploy/?$ deploy.php [L,QSA]

  # 2. Điều hướng tất cả REST API (/api/...) vào api.php
  RewriteRule ^api/(.*)$ api.php?endpoint=$1 [L,QSA]

  # 3. Cho phép truy cập /admin mở admin.html
  RewriteRule ^admin/?$ admin.html [L]

  # 4. Redirect 301 các link cũ blog-detail.html?slug=... sang /blog/:slug chuẩn SEO
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /blog-detail\.html\?slug=([^&\ ]+) [NC]
  RewriteRule ^blog-detail\.html$ /blog/%1? [R=301,L]

  # 5. URL bài viết Blog chuẩn SEO (/blog/:slug hoặc /blog/:slug.html)
  RewriteRule ^blog/([a-zA-Z0-9_-]+)(\.html)?/?$ blog-detail.html?slug=$1 [L,QSA]

  # 6. URL danh mục kiến thức (/blog hoặc /blog/)
  RewriteRule ^blog/?$ blog.html [L]

  # 7. Redirect 301 chuẩn hóa URL trang chủ (Loại bỏ index.html)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
  RewriteRule ^index\.html$ / [R=301,L]
</IfModule>
